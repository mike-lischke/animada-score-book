{
    "private": true,
    "homepage": "https://samba-chemnitz.de",
    "description": "Score management and arrangement app for our **Banda Animada de Samba** group",
    "repository": {
        "type": "git",
        "url": "https://github.com/mike-lischke/animada-score-book.git"
    },
    "license": "MIT",
    "type": "module",
    "engines": {
        "node": "^24.15.0 || ^26.0.0"
    },
    "version": "1.5.0",
    "scripts": {
        "dev": "vite --host",
        "build": "npm run generate:fonts && npm run verify:fonts && npm run generate-themes && vite build",
        "check": "tsc --noEmit && tsc -p tests/tsconfig.json --noEmit",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' 'build/**/*.{ts,mjs}'",
        "watch": "npm run watch:src & wait",
        "watch:src": "tsc --noEmit --watch",
        "test": "vitest --no-watch",
        "test:e2e": "NODE_NO_WARNINGS=1 playwright test",
        "test:e2e:headed": "NODE_NO_WARNINGS=1 playwright test --headed",
        "test:e2e:ui": "NODE_NO_WARNINGS=1 playwright test --ui",
        "serve:e2e": "tsx build/serve-dist.ts",
        "playwright:install": "playwright install chromium",
        "generate-themes": "tsx build/generate-daisyui-themes.ts",
        "generate:fonts": "tsx build/generate-smufl-metrics.ts",
        "verify:fonts": "tsx build/verify-smufl-fonts.ts",
        "start": "tsx src/server/backend.ts",
        "start-debug": "JWT_SECRET=\"for-debugging\" tsx src/server/backend.ts",
        "db:cleanup": "tsx build/db-cleanup.ts",
        "db:migrate": "tsx build/migration.ts",
        "package": "tsx build/package.ts"
    },
    "dependencies": {
        "jsonwebtoken": "9.0.3",
        "mime-types": "3.0.2",
        "mysql2": "3.24.6",
        "pg": "8.23.1"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@mdi/js": "7.4.47",
        "@mediabunny/mp3-encoder": "1.62.1",
        "@playwright/test": "1.64.1",
        "@preact/preset-vite": "2.10.6",
        "@stylistic/eslint-plugin": "5.10.0",
        "@tailwindcss/vite": "4.3.3",
        "@testing-library/preact": "3.2.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/mime-types": "3.0.1",
        "@types/node": "26.6.5",
        "@types/pg": "8.23.1",
        "@types/tabulator-tables": "6.3.6",
        "@typescript-eslint/parser": "8.72.0",
        "classnames": "2.5.1",
        "daisyui": "5.7.50",
        "esbuild": "0.28.2",
        "eslint": "10.13.0",
        "eslint-import-resolver-typescript": "4.4.5",
        "eslint-plugin-import-x": "4.17.1",
        "eslint-plugin-jsdoc": "65.4.2",
        "eslint-plugin-prefer-arrow": "1.2.3",
        "globals": "17.13.0",
        "jsdom": "30.1.3",
        "mediabunny": "1.62.1",
        "node-html-parser": "9.0.5",
        "preact": "11.0.2",
        "sass-embedded": "1.106.1",
        "tabulator-tables": "6.7.1",
        "tailwindcss": "4.3.3",
        "tsx": "4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.0",
        "vite": "8.3.5",
        "vitest": "5.0.5",
        "wavesurfer.js": "8.0.3"
    },
    "eslintConfig": {
        "extends": "preact"
    },
    "allowScripts": {
        "@parcel/watcher": true,
        "esbuild": true,
        "fsevents": true,
        "unrs-resolver": true
    }
}
