            <path
              d="M19,13H5V11H19V13Z"
            />
          </svg>
        </button>
        <span
          class="label appFooterZoomValue"
        >
          150%
        </span>
        <button
          class="btn du-btn du-btn-disabled appFooterZoomButton"
          disabled=""
          title="Zoom in"
        >
          <svg
            class="icon"
            data-icon="Add"
            fill="currentColor"
            height="1em"
            viewBox="0 0 24 24"
            width="1em"
            xmlns="http://www.w3.org/2000/svg"
          >
            <path
              d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"
            />
          </svg>
        </button>
      </div>
      <button
