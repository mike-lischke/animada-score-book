        />
      </div>
    </div>
    <div
      class="container appFooterActions"
      style="flex-direction: row; align-items: center;"
    >
      <div
        class="container appFooterZoom"
        style="flex-direction: row; align-items: center;"
      >
        <button
          class="btn du-btn appFooterZoomButton"
          title="Zoom out"
        >
          <svg
            class="icon"
            data-icon="HorizontalRule"
