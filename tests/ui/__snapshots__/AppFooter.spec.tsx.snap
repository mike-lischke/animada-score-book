        class="btn du-btn appFooterZenButton"
        id="zenModeButton"
        title="Exit Zen mode"
      >
        <svg
          class="icon"
          data-icon="ScreenNormal"
          fill="currentColor"
          height="1em"
          viewBox="0 0 24 24"
          width="1em"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
