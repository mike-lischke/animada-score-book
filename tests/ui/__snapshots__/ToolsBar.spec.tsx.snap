exports[`ToolsBar > matches the baseline snapshot with all props set 1`] = `
<div
  class="container toolsBarSurface custom-range-tools custom-range-tools"
  data-testid="range-tools"
  id="toolsBarHost"
  style="flex-direction: column; align-items: flex-end;"
>
  <div
    class="container toolsBar"
    style="flex-direction: row; align-items: center; gap: 8px;"
  >
    <span
      class="label toolsBarHeading"
    >
      Tools
    </span>
    <span
      class="toolsBarDivider"
    />
    <button
      class="btn du-btn toolsBarTool custom-range-tools"
      data-tooltip="Draw a crescendo hairpin"
    >
      <svg
        class="icon"
        data-icon="ChevronLeft"
        data-tooltip="inherit"
        fill="currentColor"
        height="1em"
        viewBox="0 0 24 24"
        width="1em"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"
        />
      </svg>
      <span
        class="label toolsBarToolCaption"
      >
        Crescendo
      </span>
    </button>
    <button
      class="btn du-btn toolsBarTool custom-range-tools"
      data-tooltip="Draw a decrescendo hairpin"
    >
      <svg
        class="icon"
        data-icon="ChevronRight"
        data-tooltip="inherit"
        fill="currentColor"
        height="1em"
        viewBox="0 0 24 24"
        width="1em"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path
          d="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"
        />
      </svg>
      <span
        class="label toolsBarToolCaption"
      >
        Decrescendo
      </span>
    </button>
    <button
      class="btn du-btn toolsBarTool custom-range-tools"
      data-tooltip="Place forte (f)"
    >
      <svg
        aria-hidden="true"
        class="smufl-glyph-view score-symbol-icon"
        height="20"
        style="--ink-left: var(--glyph-ink-spaces-left-dynamicforte, 0); --ink-width: var(--glyph-ink-spaces-width-dynamicforte, 0); --ink-top: var(--glyph-ink-spaces-top-dynamicforte, 0); --ink-bottom: var(--glyph-ink-spaces-bottom-dynamicforte, 0); --ink-box-width: 2; --ink-box-height: 2; --ink-pen-x: 1; --ink-pen-y: 1;"
        viewBox="0 0 20 20"
        width="20"
      >
        <text
          font-size="40"
          text-anchor="middle"
          x="10"
          y="10"
        >
          
        </text>
      </svg>
      <span
        class="label toolsBarToolCaption"
      >
        Forte
      </span>
    </button>
  </div>
</div>
`;

